<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="items-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-tag"></i> <%= category.name %>
                </h1>
                <p class="text-muted"><%= category.description %></p>
            </div>
            <div class="action-buttons">
                <a href="/items/new?category_id=<%= category.id %>" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add Book to <%= category.name %>
                </a>
                <a href="/categories/<%= category.id %>/edit" class="btn btn-secondary">
                    <i class="fas fa-edit"></i> Edit Category
                </a>
                <a href="/categories" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>ISBN</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (items && items.length > 0) { %>
                        <% items.forEach((item) => { %>
                            <tr>
                                <td>
                                    <strong><%= item.name %></strong>
                                    <div class="text-muted small"><%= item.description %></div>
                                </td>
                                <td><%= item.author %></td>
                                <td><code><%= item.isbn %></code></td>
                                <td>
                                    <span class="badge bg-success">
                                        $<%= item.price %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge <%= item.quantity < 10 ? 'bg-warning' : 'bg-info' %>">
                                        <%= item.quantity %> in stock
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="/items/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="POST" action="/items/<%= item.id %>/delete" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                    onclick="return confirm('Are you sure you want to delete this book?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4">No books found in this category</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
